#!/bin/sh
# HaiKrew's own check: validate the plugin folder, the node:test suites under tests/, then the mod tests under
# plugin/tests and plugin/src/mod, run by the Claude Code test kit, then the bench reference check: the same checks as a release. The node suites are *.spec.ts so the kit does not load them.
CC="${HAIKREW_CLAUDE:-claude}"   # Claude Code 2.1.287+ for `plugin test`; override with HAIKREW_CLAUDE
"$CC" plugin validate plugin || exit 1
node --test tests/*.spec.ts || exit 1
"$CC" plugin test plugin || exit 1
# The bench's hidden suites on their reference solutions, as scripts/try.sh checks them.
bench=$(bash bench/refcheck.sh 2>&1); rm -rf bench/runs
echo "$bench" | awk '$2=="REF"{n++; split($4,a,"[=/]"); if(a[2]!=a[3]||a[3]==0) bad=1} END{exit (bad||n==0)}' || { echo "$bench" >&2; exit 1; }
